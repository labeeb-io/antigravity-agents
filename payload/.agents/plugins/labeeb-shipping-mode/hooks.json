{
  "labeeb-shipping-safety": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|apply_patch|delete_file|move_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/shipping_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "labeeb-discovery-trajectory": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/discovery_drift.py",
        "timeout": 5
      }
    ]
  },
  "labeeb-discovery-stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/discovery_stop.py",
        "timeout": 5
      }
    ]
  }
}
